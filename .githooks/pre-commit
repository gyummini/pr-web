#!/bin/sh
# 커밋마다 작업진행.md를 함께 갱신하도록 강제한다.
#
# 이 저장소의 작업 이력은 대화 기록이 아니라 작업진행.md에만 남는다.
# (2026-08-13 커밋 두 건은 세션 기록이 사라져 diff로 역추적해야 했다.)
#
# 훅 연결: git config core.hooksPath .githooks
# 예외로 넘겨야 할 때: git commit --no-verify

DOC="작업진행.md"

# core.quotepath가 켜져 있으면 한글 파일명이 "ì..." 로 이스케이프되어
# 이름 비교가 전부 어긋난다. 이 저장소는 문서도 콘텐츠도 한글 파일명이라 반드시 꺼야 한다.
staged=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACMR)

# 문서만 고친 커밋, 되돌리기/병합 커밋은 통과시킨다
[ -z "$staged" ] && exit 0
if [ -f .git/MERGE_HEAD ] || [ -f .git/REVERT_HEAD ]; then exit 0; fi

# 사이트에 드러나는 변경이 있는가 (코드·스타일·콘텐츠·에셋)
work=$(printf '%s\n' "$staged" | grep -E '^(assets/|index\.html|vercel\.json|data/|콘텐츠_|스크립트_)' | head -1)
[ -z "$work" ] && exit 0

if printf '%s\n' "$staged" | grep -qx "$DOC"; then
  exit 0
fi

cat >&2 <<MSG

  ✖ $DOC 가 이번 커밋에 없습니다.

    이 저장소는 커밋마다 $DOC 의 5장(작업 이력)에 항목을 추가합니다.
    무엇을 왜 바꿨는지 / 새 파일 / 고친 버그 / 다음 세션이 헤맬 만한 것을 적고,
    아래처럼 함께 올린 뒤 다시 커밋하세요.

      git add $DOC

    문서에 남길 것이 정말 없다면:  git commit --no-verify

MSG
exit 1
